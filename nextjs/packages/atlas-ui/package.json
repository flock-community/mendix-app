{
  "name": "@flock-community/atlas-ui",
  "version": "0.1.0",
  "description": "React components that render Mendix Atlas markup, plus a tool that turns a Mendix project's theme into static CSS and assets",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format/index.ts",
    "./filters": "./src/data/filters.ts"
  },
  "bin": {
    "atlas-theme": "./bin/atlas-theme.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "date-fns": "^4.4.0",
    "downshift": "^9.4.0",
    "fflate": "^0.8.2",
    "react-datepicker": "^8.10.0",
    "sass": "1.83.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
